# Copy to deploy/.env and change every value. Never commit deploy/.env.
DOMAIN=localhost
POSTGRES_USER=endpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=endpilot
RUST_LOG=info
# Signs access tokens. At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me
# Set to false once your team's accounts exist, so strangers can't sign up.
ALLOW_REGISTRATION=true
