{
  "info": {
    "_postman_id": "0c1d2e3f-0000-4000-8000-000000000001",
    "name": "Tienda API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [
    { "key": "baseUrl", "value": "https://api.tienda.test/v1", "type": "string" },
    { "key": "pageSize", "value": 20, "type": "number" },
    { "key": "legacy", "value": "x", "disabled": true }
  ],
  "event": [{ "listen": "prerequest", "script": { "exec": ["console.log('hi')"], "type": "text/javascript" } }],
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Debug", "value": "1", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&size={{pageSize}}",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "{{pageSize}}" },
                { "key": "sort", "value": "price", "disabled": true }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Taza\",\n  \"price\": 9.5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Imágenes",
          "auth": { "type": "noauth" },
          "item": [
            {
              "name": "Subir imagen",
              "request": {
                "method": "POST",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "file", "type": "file", "src": "/home/ana/taza.png" },
                    { "key": "alt", "value": "Taza azul", "type": "text" },
                    { "key": "draft", "value": "true", "type": "text", "disabled": true }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/products/:id/images",
                  "host": ["{{baseUrl}}"],
                  "path": ["products", ":id", "images"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "user", "value": "ana", "type": "text" },
            { "key": "pass", "value": "{{password}}", "type": "text" }
          ]
        },
        "url": {
          "raw": "https://auth.tienda.test:8443/login",
          "protocol": "https",
          "host": ["auth", "tienda", "test"],
          "port": "8443",
          "path": ["login"]
        }
      }
    },
    {
      "name": "Estado (API key en query)",
      "request": {
        "auth": {
          "type": "apikey",
          "apikey": [
            { "key": "key", "value": "api_key", "type": "string" },
            { "key": "value", "value": "{{apiKey}}", "type": "string" },
            { "key": "in", "value": "query", "type": "string" }
          ]
        },
        "method": "GET",
        "url": "{{baseUrl}}/status"
      }
    },
    {
      "name": "Basic",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "ana" },
            { "key": "password", "value": "contraseña" }
          ]
        },
        "method": "delete",
        "body": { "mode": "raw", "raw": "<a/>", "options": { "raw": { "language": "xml" } } },
        "url": "{{baseUrl}}/session"
      }
    }
  ]
}
